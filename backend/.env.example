# ==========================================================
# MEDI HELP - MULTI-PROVIDER AI & VISION CONFIGURATION
# ==========================================================

# Primary Provider: "gemini" (default) | "ollama_local" | "openai" | "claude"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_VISION_PROVIDER=gemini

# 1. Google Gemini API (Primary for both Prescription Vision & Medical RAG LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Local Development / Offline Testing (Ollama + PaddleOCR)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
USE_PADDLEOCR_FALLBACK=true

# 3. Optional Cloud Providers for Testing
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Database
JWT_SECRET_KEY=medi_help_super_secret_college_project_key_2026
DATABASE_URL=sqlite:///./medi_help.db
PORT=8000
